l":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s100x200_f1/ae721c8325d1548319a8d6e3e483c36d5dec3292.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s100x200/fdd3fb01ac2d63cd0a3c60d773b0641fd078b237.gifv"},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":75,"height":42,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":75,"height":42,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s75x75_c1_f1/9a3c96314ddf63aea5825bb0f971349dba381ffc.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s75x75_c1/2768665c013917b4994ddb0e61730e5cd89bd5d5.gifv","cropped":true}],"colors":{"c0":"2e2e2d","c1":"000000","c2":"656560","c3":"999996","c4":"dfded2"}},{"type":"text","text":"Lucifer","subtype":"heading1","formatting":[{"type":"bold","start":0,"end":1},{"type":"color","start":0,"end":1,"hex":"#e22400"},{"type":"bold","start":1,"end":2},{"type":"color","start":1,"end":2,"hex":"#e64324"},{"type":"bold","start":2,"end":3},{"type":"color","start":2,"end":3,"hex":"#ea6248"},{"type":"bold","start":3,"end":4},{"type":"color","start":3,"end":4,"hex":"#ee816d"},{"type":"bold","start":4,"end":5},{"type":"color","start":4,"end":5,"hex":"#f2a191"},{"type":"bold","start":5,"end":6},{"type":"color","start":5,"end":6,"hex":"#f6c0b6"},{"type":"bold","start":6,"end":7},{"type":"color","start":6,"end":7,"hex":"#fadfda"}]},{"type":"text","text":"- 𝘓𝘶𝘤𝘪𝘧𝘦𝘳 𝘪𝘴 𝘺𝘰𝘶𝘳 𝘤𝘩𝘦𝘦𝘳𝘭𝘦𝘢𝘥𝘦𝘳, 𝘩𝘦 𝘴𝘶𝘱𝘱𝘰𝘳𝘵𝘴 𝘺𝘰𝘶𝘳 𝘭𝘰𝘰𝘬 𝘤𝘰𝘮𝘱𝘭𝘦𝘵𝘦𝘭𝘺.\n \n- 𝘓𝘪𝘬𝘦, 𝘧𝘰𝘳 𝘦𝘹𝘢𝘮𝘱𝘭𝘦 𝘪𝘧 𝘺𝘰𝘶 𝘣𝘶𝘺 𝘢 𝘯𝘦𝘸 𝘥𝘳𝘦𝘴𝘴, 𝘩𝘦 𝘩𝘪𝘴 𝘨𝘰𝘪𝘯𝘨 𝘵𝘰 𝘵𝘩𝘳𝘰𝘸 𝘱𝘭𝘦𝘯𝘵𝘺 𝘰𝘧 𝘤𝘰𝘮𝘱𝘭𝘪𝘮𝘦𝘯𝘵𝘴 𝘺𝘰𝘶𝘳 𝘸𝘢𝘺.  \n \n-𝘏𝘦 𝘩𝘰𝘯𝘦𝘴𝘵𝘭𝘺 𝘳𝘦𝘢𝘭𝘭𝘺 𝘭𝘪𝘬𝘦𝘴 𝘺𝘰𝘶 𝘣𝘶𝘵 𝘥𝘪𝘥𝘯'𝘵 𝘶𝘯𝘥𝘦𝘳𝘴𝘵𝘢𝘯𝘥 𝘺𝘰𝘶𝘳 𝘤𝘰𝘭𝘥 𝘥𝘦𝘮𝘦𝘢𝘯𝘰𝘶𝘳 𝘵𝘰𝘸𝘢𝘳𝘥𝘴 𝘩𝘪𝘮 𝘣𝘶𝘵 𝘩𝘦 𝘫𝘶𝘴𝘵 𝘨𝘪𝘷𝘦𝘴 𝘺𝘰𝘶 𝘴𝘱𝘢𝘤𝘦. \n \n-𝘞𝘩𝘦𝘯 𝘺𝘰𝘶 𝘧𝘪𝘯𝘢𝘭𝘭𝘺 𝘸𝘢𝘳𝘮 𝘶𝘱 𝘵𝘰 𝘩𝘪𝘮, 𝘩𝘦 𝘨𝘦𝘵𝘴 𝘮𝘰𝘳𝘦 𝘤𝘭𝘪𝘯𝘨𝘺 𝘢𝘯𝘥 𝘵𝘰𝘶𝘤𝘩𝘺.","formatting":[{"type":"bold","start":0,"end":64},{"type":"italic","start":0,"end":64},{"type":"small","start":0,"end":64},{"type":"bold","start":65,"end":66},{"type":"italic","start":65,"end":66},{"type":"bold","start":67,"end":162},{"type":"italic","start":67,"end":162},{"type":"small","start":67,"end":162},{"type":"small","start":162,"end":164},{"type":"small","start":169,"end":282},{"type":"italic","start":169,"end":282},{"type":"bold","start":169,"end":282},{"type":"bold","start":286,"end":350},{"type":"italic","start":286,"end":350},{"type":"small","start":286,"end":350}]},{"type":"text","text":"-𝘉𝘺 𝘵𝘩𝘢𝘵 𝘮𝘦𝘢𝘯𝘪𝘯𝘨 𝘩𝘦 𝘱𝘭𝘢𝘺𝘴 𝘸𝘪𝘵𝘩 𝘺𝘰𝘶𝘳 𝘩𝘢𝘪𝘳, 𝘤𝘶𝘥𝘥𝘭𝘦𝘴 𝘺𝘰𝘶 𝘢 𝘵𝘰𝘯, 𝘢𝘯𝘥 𝘣𝘶𝘺𝘴 𝘺𝘰𝘶 𝘵𝘩𝘦 𝘱𝘳𝘦𝘵𝘵𝘪𝘦𝘴𝘵 𝘭𝘪𝘵𝘵𝘭𝘦𝘴𝘵 𝘢𝘤𝘤𝘦𝘴𝘴𝘰𝘳𝘪𝘦𝘴. \n \n- 𝘏𝘦 𝘭𝘰𝘷𝘦𝘴 𝘺𝘰𝘶 𝘢𝘯𝘥 𝘺𝘰𝘶 𝘭𝘰𝘷𝘦 𝘩𝘪𝘮 🤍 ","formatting":[{"type":"bold","start":1,"end":109},{"type":"italic","start":1,"end":109},{"type":"small","start":1,"end":109},{"type":"small","start":115,"end":146},{"type":"italic","start":115,"end":146},{"type":"bold","start":115,"end":146}]},{"type":"image","media":[{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":600,"height":42,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":600,"height":42,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s640x960_f1/ea33f7215171522ee733ad29aa0de130d2389c2d.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s640x960/93991e28e13d14bf0f0623fee3b736af90f48f15.gifv","hasOriginalDimensions":true},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":540,"height":38,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":540,"height":38,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s540x810_f1/5238285bb74e3b6d439048c00f3174344bc8b681.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c