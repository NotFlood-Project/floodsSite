8fd3a8b7.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s250x250_c1/fe2b2fb8256ac66f8cde3775c12edd63f8aaddad.gifv","cropped":true},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":100,"height":7,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":100,"height":7,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s100x200_f1/ae721c8325d1548319a8d6e3e483c36d5dec3292.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s100x200/fdd3fb01ac2d63cd0a3c60d773b0641fd078b237.gifv"},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":75,"height":42,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":75,"height":42,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s75x75_c1_f1/9a3c96314ddf63aea5825bb0f971349dba381ffc.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s75x75_c1/2768665c013917b4994ddb0e61730e5cd89bd5d5.gifv","cropped":true}],"colors":{"c0":"2e2e2d","c1":"000000","c2":"656560","c3":"999996","c4":"dfded2"}},{"type":"text","text":"Lute  ","subtype":"heading1","formatting":[{"type":"bold","start":0,"end":1},{"type":"italic","start":0,"end":1},{"type":"color","start":0,"end":1,"hex":"#b1a0c9"},{"type":"bold","start":1,"end":2},{"type":"italic","start":1,"end":2},{"type":"color","start":1,"end":2,"hex":"#baadcc"},{"type":"bold","start":2,"end":3},{"type":"italic","start":2,"end":3},{"type":"color","start":2,"end":3,"hex":"#c3bbcf"},{"type":"bold","start":3,"end":4},{"type":"italic","start":3,"end":4},{"type":"color","start":3,"end":4,"hex":"#ccc8d2"}]},{"type":"text","text":"- 𝙷𝚘𝚗𝚎𝚜𝚝𝚕𝚢, 𝚜𝚑𝚎 𝚕𝚒𝚔𝚎𝚜 𝚒𝚝, 𝚋𝚞𝚝 𝚒𝚏 𝚊𝚗𝚢𝚘𝚗𝚎 𝚜𝚊𝚢𝚜 𝚊𝚗𝚢𝚝𝚑𝚒𝚗𝚐 𝚗𝚎𝚐𝚊𝚝𝚒𝚟𝚎 𝚊𝚋𝚘𝚞𝚝 𝚢𝚘𝚞𝚛 𝚕𝚘𝚘𝚔, 𝚝𝚑𝚎𝚢 𝚊𝚛𝚎 𝚒𝚗 𝚝𝚛𝚘𝚞𝚋𝚕𝚎. \n \n-𝚂𝚑𝚎’𝚕𝚕 𝚐𝚒𝚟𝚎 𝚢𝚘𝚞 𝚜𝚕𝚢 𝚌𝚘𝚖𝚙𝚕𝚒𝚖𝚎𝚗𝚝s 𝚕𝚒𝚔𝚎 “𝙰𝚛𝚎 𝚝𝚑𝚘𝚜𝚎 𝚗𝚎𝚠 𝚝𝚒𝚐𝚑𝚝𝚜? 𝙷𝚖… 𝚃𝚑𝚎𝚢 𝚕𝚘𝚘𝚔 𝚗𝚒𝚌𝚎…”.   \n \n- 𝚂𝚑𝚎’𝚜 𝚕𝚒𝚔𝚎 𝚢𝚘𝚞𝚛 𝚐𝚞𝚊𝚛𝚍 𝚍𝚘𝚐 𝚒𝚗 𝚊 𝚠𝚊𝚢, 𝚊𝚗𝚐𝚛𝚢 𝚘𝚗 𝚝𝚑𝚎 𝚘𝚞𝚝𝚜𝚒𝚍𝚎, 𝚜𝚠𝚎𝚎𝚝 𝚘𝚗 𝚝𝚑𝚎 𝚒𝚗𝚜𝚒𝚍𝚎.","subtype":"heading1","formatting":[{"type":"small","start":0,"end":2},{"type":"italic","start":2,"end":100},{"type":"bold","start":2,"end":100},{"type":"small","start":2,"end":100},{"type":"small","start":100,"end":101},{"type":"bold","start":105,"end":189},{"type":"italic","start":105,"end":189},{"type":"small","start":105,"end":189},{"type":"bold","start":192,"end":272},{"type":"small","start":192,"end":272},{"type":"italic","start":192,"end":272}]},{"type":"text","text":"- 𝙰𝚗𝚍 𝚜𝚘𝚖𝚎𝚝𝚒𝚖𝚎𝚜 𝚜𝚑𝚎 𝚎𝚟𝚎𝚗 𝚕𝚎𝚝𝚜 𝚢𝚘𝚞 𝚙𝚕𝚊𝚌𝚎 𝚋𝚘𝚠𝚜 𝚒𝚗 𝚑𝚎𝚛 𝚑𝚊𝚒𝚛! (𝚅𝚎𝚛𝚢 𝚛𝚊𝚛𝚎𝚕𝚢)","subtype":"heading1","formatting":[{"type":"bold","start":0,"end":58},{"type":"italic","start":0,"end":58},{"type":"small","start":0,"end":58},{"type":"bold","start":58,"end":71},{"type":"italic","start":58,"end":71},{"type":"small","start":58,"end":71},{"type":"strikethrough","start":58,"end":71}]},{"type":"text","text":"-𝙱𝚞𝚝 𝚊𝚝 𝚝𝚑𝚎 𝚎𝚗𝚍 𝚘𝚏 𝚝𝚑𝚎 𝚍𝚊𝚢, 𝚜𝚑𝚎 𝚠𝚒𝚕𝚕 𝚋𝚎 𝚝𝚑𝚎𝚛𝚎 𝚏𝚘𝚛 𝚢𝚘𝚞 𝚊𝚗𝚍 𝚢𝚘𝚞 𝚠𝚒𝚕𝚕 𝚋𝚎 𝚝𝚑𝚎𝚛𝚎 𝚏𝚘𝚛 𝚑𝚎𝚛 💜","subtype":"heading1","formatting":[{"type":"small","start":0,"end":83},{"type":"italic","start":0,"end":83},{"type":"bold","start":0,"end":83},{"type":"bold","start":84,"end":85},{"type":"italic","start":84,"end":85},{"type":"small","start":84,"end":85}]},{"type":"image","media":[{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":600,"height":42,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":600,"height":42,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s640x960_f1/ea33f7215171522ee733ad29aa0de130d2389c2d.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s640x960/93991e28e13d14bf0f0623fee3b736af90f48f15.gifv","hasOriginalDimensions":true},{"mediaKey":"54cff6185a14a7