c38849c9-1d/s250x400/da77cc323db7a3f33608882c600b6f2f057bbc22.gifv"},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":250,"height":42,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":250,"height":42,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s250x250_c1_f1/e90f9955ab90e2dfba9ecb38cbd0d1948fd3a8b7.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s250x250_c1/fe2b2fb8256ac66f8cde3775c12edd63f8aaddad.gifv","cropped":true},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":100,"height":7,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":100,"height":7,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s100x200_f1/ae721c8325d1548319a8d6e3e483c36d5dec3292.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s100x200/fdd3fb01ac2d63cd0a3c60d773b0641fd078b237.gifv"},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":75,"height":42,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":75,"height":42,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s75x75_c1_f1/9a3c96314ddf63aea5825bb0f971349dba381ffc.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s75x75_c1/2768665c013917b4994ddb0e61730e5cd89bd5d5.gifv","cropped":true}],"colors":{"c0":"2e2e2d","c1":"000000","c2":"656560","c3":"999996","c4":"dfded2"}},{"type":"text","text":"Vox","subtype":"heading1","formatting":[{"type":"color","start":0,"end":1,"hex":"#b51a00"},{"type":"bold","start":0,"end":1},{"type":"italic","start":0,"end":1},{"type":"bold","start":1,"end":2},{"type":"italic","start":1,"end":2},{"type":"color","start":1,"end":2,"hex":"#01558e"},{"type":"bold","start":2,"end":3},{"type":"italic","start":2,"end":3},{"type":"color","start":2,"end":3,"hex":"#018ec5"}]},{"type":"text","text":"-𝐻𝑒 𝒹𝑜𝑒𝓈𝓃'𝓉 𝒸𝒶𝓇𝑒, 𝒽𝑒 𝒿𝓊𝓈𝓉 𝓈𝑒𝑒𝓈 𝒾𝓉 𝒶𝓈 𝒶 𝓈𝓉𝓎𝓁𝑒 𝓎𝑜𝓊 𝒽𝒶𝓋𝑒.","formatting":[{"type":"bold","start":0,"end":54},{"type":"italic","start":0,"end":54},{"type":"small","start":0,"end":54}]},{"type":"text","text":"-𝒪𝒻 𝒸𝑜𝓊𝓇𝓈𝑒, 𝒽𝑒 𝓈𝓉𝒾𝓁𝓁 𝓉𝒽𝒾𝓃𝓀𝓈 𝓎𝑜𝓊𝓇 𝓅𝓇𝑒𝓉𝓉𝓎, 𝒷𝓊𝓉 𝒹𝑜𝑒𝓈𝓃'𝓉 𝒸𝒶𝓇𝑒 𝒶𝒷𝑜𝓊𝓉 𝒽𝑜𝓌 𝓎𝑜𝓊 𝒹𝓇𝑒𝓈𝓈 𝑜𝓇 𝒹𝑜 𝓎𝑜𝓊𝓇 𝓂𝒶𝓀𝑒𝓊𝓅. \n \n-𝑀𝑜𝓈𝓉 𝑜𝒻 𝓉𝒽𝑒 𝓉𝒾𝓂𝑒 𝓋𝑒𝓁𝓋𝑒𝓉𝓉𝑒 𝓉𝒶𝓀𝑒𝓈 𝓎𝑜𝓊 𝑜𝓊𝓉 𝓈𝒽𝑜𝓅𝓅𝒾𝓃𝑔 𝒻𝑜𝓇 𝒶𝒸𝒸𝑒𝓈𝓈𝑜𝓇𝒾𝑒𝓈, 𝓈𝒽𝑜𝑒𝓈, 𝒹𝓇𝑒𝓈𝓈𝑒𝓈, 𝐸𝓉𝒸,! \n \n- 𝐻𝑒 𝒶𝓁𝓈𝑜 𝓁𝒾𝓀𝑒𝓈 𝓉𝑜 𝑔𝒾𝓋𝑒 𝓎𝑜𝓊 𝓁𝒾𝓉𝓉𝓁𝑒 𝑔𝒾𝒻𝓉𝓈 𝓉𝒽𝓇𝑜𝓊𝑔𝒽𝑜𝓊𝓉 𝓉𝒽𝑒 𝒹𝒶𝓎, 𝓁𝒾𝓀𝑒 𝓈𝑜𝓂𝑒 𝓂𝒶𝓀𝑒𝓊𝓅, 𝓅𝓁𝓊𝓈𝒽𝒾𝑒𝓈, 𝒿𝓊𝓈𝓉 𝓁𝒾𝓉𝓉𝓁𝑒 𝓉𝒽𝒾𝓃𝑔𝓈 𝓁𝒾𝓀𝑒 𝓉𝒽𝒶𝓉.  \n \n-𝐻𝑒 𝓂𝒶𝓎 𝓁𝑜𝑜𝓀 𝓁𝒾𝓀𝑒 𝒽𝑒 𝒹𝑜𝑒𝓈𝓃𝓉 𝒸𝒶𝓇𝑒 𝒶𝒷𝑜𝓊𝓉 𝓎𝑜𝓊, 𝒷𝓊𝓉 𝒽𝑒'𝓈 𝒿𝓊𝓈𝓉 𝓆𝓊𝒾𝑒𝓉 𝒶𝒷𝑜𝓊𝓉 𝓁𝑜𝓋𝒾𝓃𝑔 𝓎𝑜𝓊 💙","formatting":[{"type":"bold","start":0,"end":96},{"type":"italic","start":0,"end":96},{"type":"small","start":0,"end":96},{"type":"small","start":100,"end":188},{"type":"italic","start":100,"end":188},{"type":"bold","start":100,"end":188},{"type":"bold","start":192,"end":310},{"type":"italic","start":192,"end":310},{"type":"small","start":192,"end":310},{"type":"bold","start":315,"end":397},{"type":"italic","start":315,"end":397},{"type":"small","start":315,"end":397}]},{"type":"image","media":[{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":600,"height":42,"poster":{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":600,"height":42,"url":"https://44.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s640x960_f1/ea33f7215171522ee733ad29aa0de130d2389c2d.gifv"},"url":"https://64.media.tumblr.com/54cff6185a14a79dda41220c51031a20/fa7b5c6ec38849c9-1d/s640x960/93991e28e13d14bf0f0623fee3b736af90f48f15.gifv","hasOriginalDimensions":true},{"mediaKey":"54cff6185a14a79dda41220c51031a20:fa7b5c6ec38849c9-1d","type":"image/webp","width":540,"height":38,"poster":{"mediaKey